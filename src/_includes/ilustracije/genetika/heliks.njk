{#- ==========================================================================
    DNK HELIKS (dekorativna traka ispod hero sekcije, stranica Genetika)
    Dve sinusne niti i prečke između njih. Crta se širina + jedan talas
    (120 jedinica), pa se cela grupa pomera ulevo za jedan talas i ponavlja
    (CSS animacija .genetika-heliks__grupa u css/stranice/genetika.css).
      sirina, visina  veličina crteža (viewBox)
      amplituda       visina talasa od sredine
      precka          razmak između prečki (deljiv sa 4)
    ========================================================================== -#}
{% macro heliks(sirina, visina, amplituda, precka, klasa = "") -%}
{#- sin(12° · k) za k = 0..29, jedan talas = 30 tačaka na po 4 jedinice -#}
{%- set sinusi = [0, 0.2079, 0.4067, 0.5878, 0.7431, 0.866, 0.9511, 0.9945, 0.9945, 0.9511, 0.866, 0.7431, 0.5878, 0.4067, 0.2079, 0, -0.2079, -0.4067, -0.5878, -0.7431, -0.866, -0.9511, -0.9945, -0.9945, -0.9511, -0.866, -0.7431, -0.5878, -0.4067, -0.2079] -%}
{%- set sredina = visina / 2 -%}
{%- set tacaka = (sirina + 120) / 4 -%}
{%- set nitA = [] -%}{%- set nitB = [] -%}
{%- for i in range(0, tacaka + 1) -%}
  {%- set y = amplituda * sinusi[i % 30] -%}
  {%- set komanda = ("M" if i == 0 else "L") + (i * 4) + " " -%}
  {%- set yA = (sredina + y) | round(1) -%}
  {%- set yB = (sredina - y) | round(1) -%}
  {%- set _ = nitA.push(komanda + yA) -%}
  {%- set _ = nitB.push(komanda + yB) -%}
{%- endfor -%}
<svg class="genetika-heliks {{ klasa }}" viewBox="0 0 {{ sirina }} {{ visina }}" preserveAspectRatio="xMinYMid slice" aria-hidden="true" focusable="false">
  <g class="genetika-heliks__grupa">
    {%- for i in range(0, tacaka + 1, precka / 4) %}
    {%- set y = amplituda * sinusi[i % 30] %}
    {%- set yA = (sredina + y) | round(1) %}
    {%- set yB = (sredina - y) | round(1) %}
    <line class="genetika-heliks__precka" x1="{{ i * 4 }}" y1="{{ yA }}" x2="{{ i * 4 }}" y2="{{ yB }}"></line>
    {%- endfor %}
    <path class="genetika-heliks__nit genetika-heliks__nit--svetla" d="{{ nitA | join(' ') }}"></path>
    <path class="genetika-heliks__nit" d="{{ nitB | join(' ') }}"></path>
  </g>
</svg>
{%- endmacro %}
