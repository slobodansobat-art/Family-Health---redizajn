{#- ==========================================================================
    OSNOVNI MAKROI (male komponente koje se koriste svuda)
    Uvoz u šablonu:
      {% from "makroi/osnovni.njk" import logo, slika, strelica, kvacica, telefonIkonica %}
    ========================================================================== -#}

{#- Logo Family Health (tekst + luk). varijanta: "tamna" (beli logo na tamnoj
    pozadini), "zlatna" (Cancer Neo) ili prazno (svetla pozadina). -#}
{% macro logo(varijanta = "", mali = false) -%}
<a href="/" class="logo{% if varijanta %} logo--{{ varijanta }}{% endif %}{% if mali %} logo--mali{% endif %}" aria-label="Family Health – početna">
  <span class="logo__tekst">Family Health<span class="logo__tm">TM</span></span>
  <svg class="logo__luk" viewBox="0 0 168 16" aria-hidden="true" focusable="false"><path d="M92 3 Q 120 20 150 3" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"></path></svg>
  <span class="logo__slogan">YOUR PEACE OF MIND</span>
</a>
{%- endmacro %}

{#- Slika sa rezervnim mestom. Dok firma ne doda fotografiju (polje u CMS-u je
    prazno), prikazuje se obojeno polje sa opisom šta tu treba da stoji.
      putanja  putanja slike iz CMS-a ("/assets/slike/x.jpg") ili prazno
      opis     alt tekst (opis slike za slepe i Google); prikazuje se i u praznom polju
      klasa    dodatne CSS klase (oblik, veličina) -#}
{% macro slika(putanja, opis, klasa = "", sirina = "", visina = "", ucitavanje = "lazy") -%}
{%- if putanja -%}
<img src="{{ putanja }}" alt="{{ opis }}" class="slika {{ klasa }}" loading="{{ ucitavanje }}" decoding="async"{% if sirina %} width="{{ sirina }}"{% endif %}{% if visina %} height="{{ visina }}"{% endif %}>
{%- else -%}
<div class="slika slika--prazna {{ klasa }}" role="img" aria-label="{{ opis }}"><span class="slika__opis">{{ opis }}</span></div>
{%- endif -%}
{%- endmacro %}

{#- Ikonice (SVG, nasleđuju boju teksta preko currentColor) -#}
{% macro strelica(velicina = 22) -%}
<svg width="{{ velicina }}" height="{{ velicina }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
{%- endmacro %}

{% macro kvacica(velicina = 18) -%}
<svg width="{{ velicina }}" height="{{ velicina }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12l5 5 9-10"></path></svg>
{%- endmacro %}

{% macro telefonIkonica(velicina = 18) -%}
<svg width="{{ velicina }}" height="{{ velicina }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
{%- endmacro %}

{% macro kucaIkonica(velicina = 14) -%}
<svg width="{{ velicina }}" height="{{ velicina }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 10.5 12 3l9 7.5V21H3z"></path><path d="M9 21v-6h6v6"></path></svg>
{%- endmacro %}

{% macro strelicaDole(velicina = 14) -%}
<svg width="{{ velicina }}" height="{{ velicina }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"></path></svg>
{%- endmacro %}

{% macro plus(velicina = 20) -%}
<svg width="{{ velicina }}" height="{{ velicina }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"></path></svg>
{%- endmacro %}
