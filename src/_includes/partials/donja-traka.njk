{#- ==========================================================================
    DONJA TRAKA ZA BRZI KONTAKT (samo mobilni, uvek na dnu ekrana)
    Tri dugmeta: Pozovite (telefon), Viber, glavno dugme stranice.
    Front matter stranice:  donjaTraka: { tekst: "...", link: "#kontakt", zlatna: true }
    Isključivanje:          donjaTraka: false
    Tekstovi i podrazumevano glavno dugme: podesavanja.tekstovi
    Telefon i Viber: podesavanja.kontakt (telefonLink, viberLink)
    Izgled: src/assets/css/komponente/donja-traka.css
    ========================================================================== -#}
{%- if donjaTraka !== false -%}
{%- set t = podesavanja.tekstovi -%}
{%- set k = podesavanja.kontakt -%}
{%- set dt = donjaTraka or { tekst: t.glavnoDugme, link: t.glavnoDugmeLink } -%}
<nav class="donja-traka{% if dt.zlatna %} donja-traka--zlatna{% endif %}" aria-label="Brzi kontakt">
  <a href="tel:{{ k.telefonLink }}" class="donja-traka__sporedno">{{ t.pozovite }}</a>
  {%- if k.viberLink %}
  <a href="{{ k.viberLink }}" class="donja-traka__sporedno">{{ t.viber }}</a>
  {%- endif %}
  <a href="{{ dt.link }}" class="donja-traka__glavno">{{ dt.tekst }}</a>
</nav>
{%- endif -%}
