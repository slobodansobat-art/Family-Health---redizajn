{#- HARMONY · paketi: izbor paketa (kartice) + zbir izabranog paketa sa ratama
    Sadržaj: stranice.harmony.paketi (cene su brojevi u JSON-u)
    Stil: css/stranice/harmony.css (.harmony-paketi)   ·   JS: js/stranice/harmony.js
    Bez JS-a: prikazan je paket iz polja "izabranPaket"; JS menja izbor na klik
    i upisuje izabrani paket u formu za zakazivanje.
    Kraći tekstovi za telefon: polja …Mobilni (prazno = desktop tekst). -#}
{%- set d = stranice.harmony.paketi -%}
<section id="paketi" class="harmony-paketi" aria-labelledby="harmony-paketi-naslov">
  <div class="kontejner">
    <h2 id="harmony-paketi-naslov" class="naslov-l harmony-naslov"><span class="samo-desktop">{{ d.naslov }}</span><span class="samo-mobilni">{{ d.naslovMobilni or d.naslov }}</span></h2>
    <p class="harmony-paketi__uvod"><span class="samo-desktop">{{ d.uvod }}</span><span class="samo-mobilni">{{ d.uvodMobilni or d.uvod }}</span></p>

    {#- Podaci za JS (cene i nazivi), isti kao u JSON-u stranice #}
    <script type="application/json" id="harmony-podaci">{{ { stavke: d.stavke, brojRata: d.rate.broj } | uJson | safe }}</script>

    <div class="harmony-paketi__izbor" data-paketi>
      {%- for p in d.stavke %}
      <button type="button" class="harmony-paket" data-paket="{{ loop.index0 }}" aria-pressed="{{ 'true' if p.naziv == d.izabranPaket else 'false' }}">
        <span class="harmony-paket__radio" aria-hidden="true"></span>
        <span class="harmony-paket__oznaka">{{ p.oznaka }}</span>
        <span class="harmony-paket__glavno">
          <span class="harmony-paket__naziv">{{ p.naziv }}</span>
          <span class="harmony-paket__opis"><span class="samo-desktop">{{ p.opis }}</span><span class="samo-mobilni">{{ p.opisMobilni or p.opis }}</span></span>
        </span>
        <span class="harmony-paket__cena">{{ p.cena | evra }}</span>
        <span class="harmony-paket__rata">{{ d.rate.kartica }} {{ (p.cena / d.rate.broj) | evra }}</span>
      </button>
      {%- endfor %}
    </div>

    {#- Zbir izabranog paketa (aria-live: čitač ekrana pročita promenu) #}
    {%- for p in d.stavke %}{% if p.naziv == d.izabranPaket %}
    <div class="harmony-paketi__zbir" aria-live="polite">
      <div class="harmony-paketi__zbir-opis">
        <p class="harmony-paketi__zbir-oznaka">{{ d.izabraliSte }}</p>
        <p class="harmony-paketi__zbir-naziv" data-izbor="naziv">{{ p.naziv }}</p>
        <p class="harmony-paketi__zbir-tekst" data-izbor="opis">{{ p.opis }}</p>
      </div>
      <div class="harmony-paketi__zbir-cena">
        <p class="harmony-paketi__zbir-iznos" data-izbor="cena">{{ p.cena | evra }}</p>
        <p class="harmony-paketi__zbir-rata">{{ d.rate.izbor }} <span data-izbor="rata">{{ (p.cena / d.rate.broj) | evra }}</span>{{ d.rate.izborKraj }}</p>
        <p class="harmony-paketi__zbir-banka">{{ d.rate.banka }}</p>
      </div>
      <a href="{{ d.dugme.link }}" class="dugme harmony-paketi__dugme">{{ d.dugme.tekst }}</a>
    </div>
    {%- endif %}{% endfor %}

    <p class="harmony-paketi__symphony"><span class="samo-desktop">{{ d.symphonyMd | mdRed | safe }}</span><span class="samo-mobilni">{{ (d.symphonyMobilniMd or d.symphonyMd) | mdRed | safe }}</span></p>

    {#- Samo na mobilnom: kratka napomena o kombinovanom testu odmah uz pakete #}
    <p class="harmony-paketi__napomena samo-mobilni">{{ d.napomenaMobilniMd | mdRed | safe }}</p>

    {#- Popust 300 € na matične ćelije uz prenatalni test (ikonica: poklon) #}
    {%- if d.popustMd %}
    <p class="harmony-popust">
      <svg class="harmony-popust__ikonica" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v9H5v-9"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>
      <span>{{ d.popustMd | mdRed | safe }}</span>
    </p>
    {%- endif %}
  </div>
</section>
