{#- SYMPHONY · "Od poziva do nalaza": četiri kartice postupka
    Desktop: ikonica u kartici. Mobilni: redni broj u krugu umesto ikonice.
    Sadržaj: stranice.symphony.proces   ·   Stil: css/stranice/symphony.css -#}
{%- set d = stranice.symphony.proces -%}
{#- Ikonice koraka (ključ iz JSON-a: telefon | kuca | epruveta | nalaz) -#}
{%- macro ikonica(ime) -%}
<svg class="symphony-proces__ikonica" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- if ime == "telefon" -%}<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
  {%- elif ime == "kuca" -%}<path d="M3 11l9-7 9 7"></path><path d="M5 10v10h14V10"></path><path d="M10 20v-6h4v6"></path>
  {%- elif ime == "epruveta" -%}<path d="M9 3h6"></path><path d="M10 3v6L5 18a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3L14 9V3"></path><path d="M7.5 14h9"></path>
  {%- else -%}<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M9 15l2 2 4-4"></path>
  {%- endif -%}
</svg>
{%- endmacro %}
<section class="symphony-proces kontejner" aria-labelledby="symphony-proc">
  <h2 id="symphony-proc" class="naslov-m symphony-naslov symphony-proces__naslov">{{ d.naslov }}</h2>
  <ol class="symphony-proces__lista">
    {%- for k in d.koraci %}
    <li class="symphony-proces__korak{% if k.istaknuto %} symphony-proces__korak--istaknuto{% endif %}">
      {{ ikonica(k.ikonica) }}
      <span class="symphony-proces__broj" aria-hidden="true">{{ loop.index }}</span>
      <span class="symphony-proces__tekst"><strong>{{ k.naslov }}</strong><span>{{ k.tekst }}</span></span>
    </li>
    {%- endfor %}
  </ol>
</section>
