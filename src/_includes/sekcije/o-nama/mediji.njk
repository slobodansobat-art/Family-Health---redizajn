{#- O NAMA · nastupi u medijima (kartice; link ka snimku kad postoji)
    Sadržaj: stranice.oNama.mediji   ·   Stil: css/stranice/o-nama.css
    Desktop: mreža od tri kolone. Mobilni: vodoravni niz koji se prevlači.
    Kartica bez linka (link je prazan u CMS-u) nije klikabilna. -#}
{%- from "makroi/osnovni.njk" import slika -%}
{%- set d = stranice.oNama.mediji -%}
<section id="mediji" class="onama-mediji" aria-labelledby="onama-mediji-naslov">
  <div class="kontejner">
    <h2 id="onama-mediji-naslov" class="onama-naslov onama-mediji__naslov">{{ d.naslov }}</h2>
    <p class="blag onama-mediji__uvod">{{ d.tekst }}</p>
    <div class="onama-mediji__skrol" role="region" aria-label="{{ d.listaOpis }}" tabindex="0">
      <ul class="onama-mediji__lista">
        {%- for n in d.nastupi %}
        <li class="onama-mediji__stavka">
          {%- if n.link %}
          <a href="{{ n.link }}" class="onama-nastup onama-nastup--link" target="_blank" rel="noopener">
          {%- else %}
          <div class="onama-nastup">
          {%- endif %}
            {{ slika(n.slika, n.slikaOpis, "onama-nastup__kadar") }}
            <span class="onama-nastup__kanal">{{ n.kanal }}</span>
            <span class="onama-nastup__naslov">{{ n.naslov }}</span>
            <span class="onama-nastup__detalji">{{ n.detalji }}</span>
          {%- if n.link %}
          </a>
          {%- else %}
          </div>
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>
