{#- O NAMA · tim: fotografija, ime i uloga
    Sadržaj: stranice.oNama.tim   ·   Stil: css/stranice/o-nama.css -#}
{%- from "makroi/osnovni.njk" import slika -%}
{%- set d = stranice.oNama.tim -%}
<section class="kontejner onama-tim" aria-labelledby="onama-tim-naslov">
  <h2 id="onama-tim-naslov" class="onama-naslov onama-tim__naslov">{{ d.naslov }}</h2>
  <p class="blag onama-tim__uvod">{{ d.tekst }}</p>
  <ul class="onama-tim__lista">
    {%- for c in d.clanovi %}
    <li class="onama-clan">
      {{ slika(c.slika, c.slikaOpis, "onama-clan__foto") }}
      <strong class="onama-clan__ime">{{ c.ime }}</strong>
      <span class="onama-clan__uloga">{{ c.uloga }}</span>
    </li>
    {%- endfor %}
  </ul>
</section>
