{#- ZA LEKARE · "Pomažemo i vama": šta preuzimamo od lekara
    Desktop: uvod levo (lepi se pri skrolu), lista u dve kolone desno.
    Mobilni: uvod, lista, pa dugme za direktnu liniju.
    Sadržaj: stranice.zaLekare.pomoc  ·  telefon: podesavanja.kontakt.mobilni
    Ikonice: ilustracije/za-lekare/ikonice.njk  ·  Stil: css/stranice/za-lekare.css (.lekari-pomoc) -#}
{%- from "ilustracije/za-lekare/ikonice.njk" import ikonica -%}
{%- set d = stranice.zaLekare.pomoc -%}
{%- set k = podesavanja.kontakt -%}
<section class="lekari-pomoc" aria-labelledby="lekari-pomoc-naslov">
  <div class="kontejner lekari-pomoc__mreza">
    <div class="lekari-pomoc__levo">
      <p class="lekari-pomoc__nadnaslov">{{ d.nadnaslov }}</p>
      <h2 id="lekari-pomoc-naslov" class="naslov-l lekari-pomoc__naslov">{{ d.naslov }}</h2>
      <p class="blag lekari-pomoc__tekst">{{ d.tekst }}</p>
      <a href="tel:{{ k.mobilniLink }}" class="dugme lekari-pomoc__dugme">{{ d.dugmeTelefon }} {{ k.mobilni }}</a>
    </div>
    <ul class="lekari-pomoc__lista">
      {%- for s in d.stavke %}
      <li class="lekari-pomoc__stavka">
        <span class="lekari-pomoc__ikonica">{{ ikonica(s.ikonica, 26) }}</span>
        <span><strong>{{ s.naslov }}</strong><span>{{ s.tekst }}</span></span>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
