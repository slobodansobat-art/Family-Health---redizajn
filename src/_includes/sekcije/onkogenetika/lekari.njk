{#- ONKOGENETIKA · za lekare ("Pomažemo i vama") + direktna linija za lekare
    Sadržaj: stranice.onkogenetika.lekari, telefon iz podesavanja.kontakt.mobilni
    Stil: css/stranice/onkogenetika.css (.onko-lekari) -#}
{%- set d = stranice.onkogenetika.lekari -%}
{%- set k = podesavanja.kontakt -%}
<section id="lekari" class="onko-lekari" aria-labelledby="onko-lekari-naslov">
  <div class="kontejner onko-lekari__mreza">
    <div class="onko-lekari__levo">
      <p class="nadnaslov">{{ d.nadnaslov }}</p>
      <h2 id="onko-lekari-naslov" class="naslov-l onko-lekari__naslov">{{ d.naslov }}</h2>
      <p class="blag onko-lekari__tekst">{{ d.tekst }}</p>
      <p class="onko-lekari__pomoc">{{ d.pomocMd | mdRed | safe }}</p>
      <h3 class="onko-lekari__podnaslov">{{ d.uzorakNaslov }}</h3>
      <ul class="onko-lekari__uzorak">
        {%- for u in d.uzorak %}
        <li>{{ u }}</li>
        {%- endfor %}
      </ul>
      <a href="{{ d.dugme.link }}" class="dugme onko-lekari__dugme">{{ d.dugme.tekst }}</a>
    </div>

    <div class="onko-lekari__kartica">
      <p class="onko-lekari__linija">{{ d.linijaNaslov }}</p>
      <a href="tel:{{ k.mobilniLink }}" class="onko-lekari__telefon">{{ k.mobilni }}</a>
    </div>
  </div>
</section>
