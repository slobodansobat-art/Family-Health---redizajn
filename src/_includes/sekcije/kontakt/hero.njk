{#- KONTAKT · uvod + tri kanala (telefon, mejl, ordinacija)
    Sadržaj: stranice.kontakt.hero (oznake) + podesavanja.kontakt (brojevi, mejl, adresa)
    Stil: css/stranice/kontakt.css -#}
{%- set d = stranice.kontakt.hero -%}
{%- set k = podesavanja.kontakt -%}
<section class="kontakt-hero" aria-labelledby="kontakt-naslov">
  <div class="kontejner kontakt-hero__unutra">
    <h1 id="kontakt-naslov" class="naslov-xl kontakt-hero__naslov">{{ d.naslov }}</h1>
    <p class="kontakt-hero__tekst">{{ d.tekst }}</p>

    <ul class="kontakt-kanali">
      {#- Telefon i mobilni (Viber) #}
      <li class="kontakt-kanal">
        <svg class="kontakt-kanal__ikonica" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
        <span class="kontakt-kanal__oznaka">{{ d.kanalTelefon }}</span>
        <a href="tel:{{ k.telefonLink }}" class="kontakt-kanal__vrednost">{{ k.telefon }}</a>
        <a href="tel:{{ k.mobilniLink }}" class="kontakt-kanal__vrednost">{{ k.mobilni }}</a>
      </li>
      {#- Mejl #}
      <li class="kontakt-kanal">
        <svg class="kontakt-kanal__ikonica" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
        <span class="kontakt-kanal__oznaka">{{ d.kanalMejl }}</span>
        <a href="mailto:{{ k.email }}" class="kontakt-kanal__vrednost">{{ k.email }}</a>
      </li>
      {#- Adresa ordinacije #}
      <li class="kontakt-kanal">
        <svg class="kontakt-kanal__ikonica" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
        <span class="kontakt-kanal__oznaka">{{ d.kanalOrdinacija }}</span>
        <address class="kontakt-kanal__vrednost">{{ k.adresa }}, {{ k.mesto }}</address>
      </li>
    </ul>
  </div>
</section>
