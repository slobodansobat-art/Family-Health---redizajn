{#- GENETIKA · izbor situacije (tabovi) i testovi za izabranu situaciju
    Sadržaj: stranice.genetika.situacije   ·   Stil: css/stranice/genetika.css
    Tabovi: zajednička komponenta [data-tabovi] (JS u glavni.js: klik,
    strelice, Home/End, #genetika-situacija-N u adresi otvara tu situaciju).
    Bez JS-a svi paneli su vidljivi jedan ispod drugog. -#}
{%- set d = stranice.genetika.situacije -%}
<section class="genetika-situacije" aria-labelledby="genetika-situacije-naslov">
  <div class="kontejner">
    <h2 id="genetika-situacije-naslov" class="naslov-m genetika-situacije__naslov">{{ d.naslov }}</h2>

    <div data-tabovi>
      <div class="genetika-tabovi" role="tablist" aria-label="Situacije">
        {%- for s in d.stavke %}
        <button type="button" class="genetika-tab" role="tab" id="genetika-tab-{{ loop.index }}" aria-controls="genetika-situacija-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ s.oznaka }}</button>
        {%- endfor %}
      </div>

      {%- for s in d.stavke %}
      <div class="genetika-panel" role="tabpanel" id="genetika-situacija-{{ loop.index }}" aria-labelledby="genetika-tab-{{ loop.index }}" tabindex="0">
        <h3 class="genetika-panel__naslov">{{ s.naslov }}</h3>
        <p class="genetika-panel__uvod">{{ s.uvod }}</p>
        <a href="{{ d.dugme.link }}" class="dugme genetika-panel__dugme">{{ d.dugme.tekst }}</a>
        <ul class="genetika-panel__testovi">
          {%- for t in s.testovi %}
          <li class="genetika-test">
            <div class="genetika-test__vrh">
              <strong class="genetika-test__naziv">{{ t.naziv }}</strong>
              <span class="genetika-test__oznaka">{{ t.oznaka }}</span>
            </div>
            <p class="genetika-test__opis">{{ t.opis }}</p>
            <p class="genetika-test__meta">
              <span><span class="blag">{{ d.oznakaUzorak }}</span> {{ t.uzorak }}</span>
              <span class="genetika-test__tacka" aria-hidden="true">·</span>
              <span><span class="blag">{{ d.oznakaRezultat }}</span> {{ t.rezultat }}</span>
            </p>
          </li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </div>

    <p class="genetika-situacije__ostalo">{{ d.ostaloMd | mdRed | safe }}</p>
  </div>
</section>
