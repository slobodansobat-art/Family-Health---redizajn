{#- GENETIKA · hero: naslov + animacija "nasleđivanje" (hromozomi mame i tate -> beba)
    Sadržaj: stranice.genetika.hero (natpisi na crtežu: hero.crtez)
    Stil: css/stranice/genetika.css   ·   Crtanje: js/stranice/genetika.js
    Desktop: crtež desno od teksta, preko cele visine sekcije.
    Mobilni: crtež ispod teksta. -#}
{%- set d = stranice.genetika.hero -%}
<section class="genetika-hero" aria-labelledby="genetika-naslov">
  <div class="kontejner genetika-hero__unutra">
    <p class="nadnaslov genetika-hero__nadnaslov">{{ d.nadnaslov }}</p>
    <h1 id="genetika-naslov" class="naslov-xl genetika-hero__naslov">{{ d.naslov }}</h1>
    <p class="genetika-hero__tekst">{{ d.tekst }}</p>
  </div>
  <div class="genetika-hero__crtez" aria-hidden="true">
    <canvas class="genetika-hero__platno" data-nasledjivanje data-mama="{{ d.crtez.mama }}" data-tata="{{ d.crtez.tata }}" data-beba="{{ d.crtez.beba }}"></canvas>
  </div>
</section>
