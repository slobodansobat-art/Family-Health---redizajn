{#- TRUDNOĆA · matične ćelije ukratko (sidro #maticne), kartica sa cenom i ratama
    Sadržaj: stranice.trudnoca.maticne   ·   Stil: css/stranice/trudnoca.css
    Rata = cena / broj rata (računa se pri izradi, filter evra).
    Cena uz prenatalni test = cena − popust (polja kartica.popust i popustTekst).
    Mobilni: kraći tekstovi (polja …Mobilni, prazno = desktop tekst); uvod i lista
    su na telefonu sažeti u jedan pasus (uvodMobilni), da se ne izgube činjenice. -#}
{%- set d = stranice.trudnoca.maticne -%}
{%- set k = d.kartica -%}
<section id="maticne" class="trudnoca-maticne" aria-labelledby="trudnoca-maticne-naslov">
  <svg class="trudnoca-talas trudnoca-talas--gore" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 0 H1440 V18 C1200 60 960 6 720 30 C480 54 240 8 0 34 Z"></path></svg>
  <div class="kontejner trudnoca-maticne__unutra">
    <div class="trudnoca-poruka-mesto" aria-live="polite" data-poruka="maticne"></div>
    <div class="trudnoca-maticne__mreza">
      <div class="trudnoca-maticne__levo">
        <h2 id="trudnoca-maticne-naslov" class="trudnoca-naslov-kurziv trudnoca-maticne__naslov"><span class="samo-desktop">{{ d.naslov }}</span><span class="samo-mobilni">{{ d.naslovMobilni or d.naslov }}</span></h2>
        <p class="trudnoca-maticne__uvod{% if d.uvodMobilni %} samo-desktop{% endif %}">{{ d.uvod }}</p>
        {#- Telefon: uvod i lista ukratko, u jednom pasusu (uvodMobilni); prazno = uvod i lista kao na desktopu #}
        {%- if d.uvodMobilni %}
        <p class="trudnoca-maticne__uvod samo-mobilni">{{ d.uvodMobilni }}</p>
        {%- endif %}
        <ul class="trudnoca-maticne__lista{% if d.uvodMobilni %} samo-desktop{% endif %}">
          {%- for s in d.stavke %}<li>{{ s }}</li>{% endfor %}
        </ul>
      </div>
      <div class="trudnoca-maticne__kartica">
        <h3 class="trudnoca-maticne__kartica-naslov">{{ k.naslov }}</h3>
        <p class="blag"><span class="samo-desktop">{{ k.tekst }}</span><span class="samo-mobilni">{{ k.tekstMobilni or k.tekst }}</span></p>
        <p class="trudnoca-maticne__cena">{{ k.cena | evra }}</p>
        {%- set rata = (k.cena / k.brojRata) | evra %}
        <p class="trudnoca-maticne__rate"><span class="samo-desktop">{{ k.rateTekst | replace("{broj}", k.brojRata | string) | replace("{rata}", rata) }}</span><span class="samo-mobilni">{{ (k.rateTekstMobilni or k.rateTekst) | replace("{broj}", k.brojRata | string) | replace("{rata}", rata) }}</span></p>
        {#- Cena uz prenatalni test kod nas = cena − popust #}
        {%- set saPopustom = (k.cena - k.popust) | evra %}
        <p class="trudnoca-maticne__popust"><span class="samo-desktop">{{ k.popustTekst | replace("{cena}", saPopustom) | replace("{popust}", k.popust | evra) }}</span><span class="samo-mobilni">{{ (k.popustTekstMobilni or k.popustTekst) | replace("{cena}", saPopustom) | replace("{popust}", k.popust | evra) }}</span></p>
        <p class="trudnoca-maticne__isticanje"><span class="samo-desktop">{{ k.isticanje }}</span><span class="samo-mobilni">{{ k.isticanjeMobilni or k.isticanje }}</span></p>
        <p class="trudnoca-maticne__napomena"><span class="samo-desktop">{{ k.napomena }}</span><span class="samo-mobilni">{{ k.napomenaMobilni or k.napomena }}</span></p>
        <a href="{{ k.dugme.link }}" class="dugme trudnoca-maticne__dugme">{{ k.dugme.tekst }}</a>
      </div>
    </div>
  </div>
</section>
