{#- TRUDNOĆA · vremenska linija "Šta je važno, i kada" (trenutna faza prema nedelji iz alata)
    Sadržaj: stranice.trudnoca.vremenskaLinija   ·   Stil: css/stranice/trudnoca.css
    JS (trudnoca.js) pomera oznaku "Vi ste ovde" kad se promeni nedelja.
    Mobilna skica je nema, ali je zadržana i na telefonu (uspravna lista, bez krive),
    da se ne izgube rokovi i koraci (odluka vlasnika: ne gubimo sadržaj). -#}
{%- set d = stranice.trudnoca.vremenskaLinija -%}
{%- set n = stranice.trudnoca.alat.podrazumevanaNedelja -%}
{#- Ista pravila kao u JS-u: do 14. nedelje faza 2, 15–21 faza 3, 22–36 faza 4, od 37. faza 5 -#}
{%- set trenutna = 1 if n < 15 else (2 if n < 22 else (3 if n < 37 else 4)) -%}
{#- Visina tačke na krivoj (px), redom za faze; prati putanju u SVG-u ispod -#}
{%- set visine = [100, 48, 96, 44, 88] -%}
<section class="trudnoca-linija" aria-labelledby="trudnoca-linija-naslov">
  <div class="kontejner">
    <div class="zaglavlje-sekcije zaglavlje-sekcije--centar trudnoca-linija__zaglavlje">
      <h2 id="trudnoca-linija-naslov" class="trudnoca-naslov-kurziv">{{ d.naslov }}</h2>
      <p class="blag">{{ d.tekst }}</p>
    </div>
    <div class="trudnoca-linija__skrol">
      <div class="trudnoca-linija__unutra">
        <svg class="trudnoca-linija__kriva" viewBox="0 0 1200 160" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 112 C40 109 60 111 120 100 C180 89 280 49 360 48 C440 47 520 97 600 96 C680 95 760 45 840 44 C920 43 1020 82 1080 88 C1140 94 1160 83 1200 80"></path></svg>
        <ol class="trudnoca-linija__faze" data-linija>
          {%- for f in d.faze %}
          {%- set i = loop.index0 %}
          <li class="trudnoca-faza{% if i == trenutna %} je-trenutna{% elif i < trenutna %} je-prosla{% endif %}" style="--y: {{ visine[i] or 80 }}px"{% if i == trenutna %} aria-current="step"{% endif %}>
            <span class="trudnoca-faza__tacka" aria-hidden="true"></span>
            <span class="trudnoca-faza__kada">{{ f.kada }}</span>
            <strong class="trudnoca-faza__naslov">{{ f.naslov }}</strong>
            <span class="trudnoca-faza__tekst">{{ f.tekst }}</span>
            <span class="trudnoca-faza__oznaka" data-faza-oznaka>{% if i == trenutna %}{{ d.oznakaOvde }}{% endif %}</span>
          </li>
          {%- endfor %}
        </ol>
      </div>
    </div>
  </div>
</section>
