{#- POČETNA · lekar: fotografija i citat dr Antovića
    Tekst o medijima (spisak TV kuća) ostaje i na telefonu; link ima kraći
    tekst za telefon (medijiLink.tekstMobilni, prazno = desktop tekst).
    Sadržaj: stranice.pocetna.lekar   ·   Stil: css/stranice/pocetna.css -#}
{%- from "makroi/osnovni.njk" import slika -%}
{%- set d = stranice.pocetna.lekar -%}
<section class="pocetna-lekar" aria-labelledby="pocetna-lekar-citat">
  <div class="kontejner pocetna-lekar__mreza">
    <div class="pocetna-lekar__foto-okvir">
      <span class="pocetna-lekar__krug" aria-hidden="true"></span>
      {{ slika(d.slika, d.slikaOpis, "slika--krug pocetna-lekar__foto") }}
    </div>
    <figure class="pocetna-lekar__citat">
      <p class="pocetna-lekar__nadnaslov">{{ d.nadnaslov }}</p>
      <blockquote id="pocetna-lekar-citat">{{ d.citat }}</blockquote>
      <figcaption>{{ d.potpis }}</figcaption>
      <p class="pocetna-lekar__mediji">{{ d.medijiTekst }} <a href="{{ d.medijiLink.link }}"><span class="samo-desktop">{{ d.medijiLink.tekst }}</span><span class="samo-mobilni">{{ d.medijiLink.tekstMobilni or d.medijiLink.tekst }}</span></a></p>
    </figure>
  </div>
</section>
